<!DOCTYPE html>
<html lang="{{ language.code|default(lang)|default('ar') }}" dir="{{ theme.is_rtl|default(true) ? 'rtl' : 'ltr' }}">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ page.title|default(store.name) }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ store.description|default('BellaBox — عناية وجمال مختاران بعناية') }}{% endblock %}">
  <meta name="theme-color" content="{{ theme.color.primary|default('#c45678') }}">
  <meta property="og:title" content="{% block og_title %}{{ page.title|default(store.name) }}{% endblock %}">
  <meta property="og:description" content="{% block og_description %}{{ store.description|default('BellaBox — عناية وجمال مختاران بعناية') }}{% endblock %}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ store.url }}">
  <meta property="og:image" content="{{ store.logo }}">
  {% if store.favicon %}<link rel="icon" href="{{ store.favicon }}">{% endif %}
  {% hook 'head:start' %}
  {% hook 'head' %}
  {% block styles %}{% endblock %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ 'assets/styles/main.css'|asset }}">
  <link rel="stylesheet" href="{{ 'assets/styles/header.css'|asset }}">
  <link rel="stylesheet" href="{{ 'assets/styles/products.css'|asset }}">
  <link rel="stylesheet" href="{{ 'assets/styles/footer.css'|asset }}">
  <link rel="stylesheet" href="{{ 'assets/styles/account.css'|asset }}">
  <style>:root{--brand-primary:{{ theme.color.primary|default('#c45678') }};--brand-dark:{{ theme.color.darker(0.15)|default('#9d3f60') }};--brand-light:{{ theme.color.lighter(0.15)|default('#e9a8ba') }};}</style>
  {# Vercel Speed Insights #}
  <script>
    window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/speed-insights/script.js"></script>
  {% hook 'head:end' %}
</head>
<body id="app" class="bellabox-theme {{ theme.settings.get('footer_is_dark', true) ? 'footer-is-dark' : '' }}">
  <a class="skip-link" href="#main-content">تخطّي إلى المحتوى</a>
  {% hook 'body:start' %}
  {% include 'components/header/header.twig' %}
  <main id="main-content" role="main">{% block content %}{% endblock %}</main>
  {% include 'components/footer/footer.twig' %}
  {% hook 'body:end' %}
  {% if theme.settings.get('enable_add_product_toast', true) %}<salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>{% endif %}
  <salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
  <salla-search data-testid="store-search-modal"></salla-search>
  <salla-login-modal data-testid="store-login-modal"></salla-login-modal>
  {% if store.scope %}<salla-scopes selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>{% endif %}
  <button class="back-to-top" type="button" aria-label="العودة إلى أعلى الصفحة"><i class="sicon-keyboard_arrow_up"></i></button>
  <script defer src="{{ 'assets/js/main.js'|asset }}"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
