<footer class="site-footer">
  <section class="newsletter-section"><div class="container newsletter-inner"><div><span class="eyebrow eyebrow-light">نحن هنا لمساعدتك</span><h2>اختاري بثقة، واسألي براحتك</h2><p>فريقنا جاهز لمساعدتك في اختيار المنتجات، متابعة الطلب، أو الإجابة عن أي استفسار.</p></div><div class="footer-cta-actions">{% if store.phone %}<a class="btn btn-footer" href="tel:{{ store.phone }}"><i class="sicon-phone"></i> اتصلي بنا</a>{% endif %}{% if store.social_media.whatsapp %}<a class="btn btn-footer btn-footer-ghost" href="{{ store.social_media.whatsapp }}" target="_blank" rel="noopener"><i class="sicon-whatsapp"></i> واتساب</a>{% elseif store.email %}<a class="btn btn-footer btn-footer-ghost" href="mailto:{{ store.email }}"><i class="sicon-mail"></i> راسلينا</a>{% endif %}</div></div></section>
  <div class="footer-main"><div class="container footer-grid">
    <div class="footer-brand"><a class="brand-lockup footer-lockup" href="{{ store.url }}">{% if store.logo %}<img src="{{ store.logo }}" alt="{{ store.name }}">{% else %}<span class="brand-mark">B</span><span class="brand-name">{{ store.name }}</span>{% endif %}</a><p>{{ store.description|default('وجهتك لاكتشاف مستحضرات الجمال والعناية الأصلية، باختيارات بسيطة وتجربة مريحة.') }}</p><div class="social-links">{% if store.social_media.instagram %}<a href="{{ store.social_media.instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><i class="sicon-instagram"></i></a>{% endif %}{% if store.social_media.twitter %}<a href="{{ store.social_media.twitter }}" aria-label="X" target="_blank" rel="noopener"><i class="sicon-twitter"></i></a>{% endif %}{% if store.social_media.whatsapp %}<a href="{{ store.social_media.whatsapp }}" aria-label="WhatsApp" target="_blank" rel="noopener"><i class="sicon-whatsapp"></i></a>{% endif %}</div></div>
    <div><h3>اكتشفي</h3><a href="{{ link('/products') }}">كل المنتجات</a><a href="{{ link('/offers') }}">العروض</a><a href="{{ link('/brands') }}">الماركات</a><a href="{{ link('/blog') }}">مجلة BellaBox</a></div>
    <div><h3>خدمة العملاء</h3><a href="{{ link('/page/shipping-policy') }}">الشحن والتوصيل</a><a href="{{ link('/page/return-policy') }}">الاستبدال والاسترجاع</a><a href="{{ link('/page/privacy-policy') }}">الخصوصية</a><a href="{{ link('/page/contact') }}">تواصلي معنا</a></div>
    <div><h3>نحن هنا لمساعدتك</h3><div class="footer-contact">{% if store.phone %}<a href="tel:{{ store.phone }}"><i class="sicon-phone"></i><span>{{ store.phone }}</span></a>{% endif %}{% if store.email %}<a href="mailto:{{ store.email }}"><i class="sicon-mail"></i><span>{{ store.email }}</span></a>{% endif %}{% if store.address %}<span><i class="sicon-location"></i><span>{{ store.address }}</span></span>{% endif %}</div><div class="payment-note"><i class="sicon-shield-check"></i><span>دفع آمن ومشفر<br><small>نحمي بياناتك في كل خطوة</small></span></div></div>
  </div></div>
  <div class="footer-bottom"><div class="container footer-bottom-inner"><span>© {{ 'now'|date('Y') }} {{ store.name }}. جميع الحقوق محفوظة.</span><span>صُمم بعناية لتجربة أجمل.</span></div></div>
</footer>
