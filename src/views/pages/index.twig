{% extends 'layouts/master.twig' %}
{% block title %}{{ store.name }} — جمالك، باختيار أجمل{% endblock %}
{% block description %}{{ store.description|default('اكتشفي منتجات العناية والجمال الأصلية المختارة بعناية من BellaBox.') }}{% endblock %}
{% block content %}
  <section class="home-intro"><div class="container home-intro-inner"><div class="home-intro-copy"><span class="eyebrow">اختياراتك تبدأ من هنا</span><h1>روتين أجمل،<br><em>بخطوات أبسط.</em></h1><p>منتجات عناية وجمال أصلية تساعدك على اختيار ما يناسبك — بثقة، وبكل حب.</p><div class="home-intro-actions"><a class="btn btn-primary" href="{{ link('/products') }}">اكتشفي المنتجات <i class="sicon-keyboard_arrow_left"></i></a><a class="btn btn-soft" href="{{ link('/offers') }}">تصفحي العروض</a></div><div class="home-intro-meta"><span><b>100%</b> منتجات أصلية</span><span><b>24/7</b> دعم نعتز به</span></div></div><div class="home-intro-art"><div class="art-circle"></div><div class="art-card art-card-top"><i class="sicon-heart"></i><span>اختيارات تحبينها</span></div><div class="art-card art-card-bottom"><i class="sicon-shield-check"></i><span>جمال بثقة</span></div><div class="art-word">bella<br><strong>box</strong></div></div></div></section>
  <div class="container"><div class="home-benefits"><div><i class="sicon-shipping-fast"></i><span><b>شحن سريع</b><small>لكل مناطق المملكة</small></span></div><div><i class="sicon-shield-check"></i><span><b>دفع آمن</b><small>خيارات دفع موثوقة</small></span></div><div><i class="sicon-refresh"></i><span><b>استرجاع سهل</b><small>سياسة واضحة ومرنة</small></span></div><div><i class="sicon-headphones"></i><span><b>معك دائمًا</b><small>دعم يرد عليك</small></span></div></div></div>
  {% component home %}
  {% if theme.settings.get('show_editorial_banner', true) %}<section class="editorial-banner"><div class="container editorial-inner"><div><span class="eyebrow">دليل BellaBox</span><h2>اختاري روتينك<br>على مهل.</h2><p>من أساسيات العناية اليومية إلى اللمسات التي تكمل إطلالتك، جمعنا لك خيارات تستحق التجربة.</p><a class="btn btn-outline" href="{{ link('/blog') }}">اقرئي دليلنا <i class="sicon-keyboard_arrow_left"></i></a></div><div class="editorial-stamp"><span>BEAUTY<br>EDIT</span><i class="sicon-sparkles"></i></div></div></section>{% endif %}
  {% if store.settings.category.testimonial_enabled %}<div class="container home-testimonials">{% component 'home.testimonials' %}</div>{% endif %}
{% endblock %}
{% block scripts %}<style>.home-intro{background:linear-gradient(120deg,#fff8f6 0%,#f9e9ed 100%);overflow:hidden}.home-intro-inner{min-height:510px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:30px}.home-intro-copy{padding:70px 0}.home-intro h1{font-size:clamp(2.6rem,6vw,5.2rem);line-height:1.12;letter-spacing:-.07em;margin:16px 0}.home-intro h1 em{font-style:normal;color:var(--color-primary)}.home-intro-copy p{color:#6b6269;max-width:490px;font-size:1rem}.home-intro-actions{display:flex;gap:10px;flex-wrap:wrap;margin:26px 0}.home-intro-meta{display:flex;gap:28px;color:#756a70;font-size:.75rem}.home-intro-meta b{display:block;color:var(--color-primary);font-size:1rem}.home-intro-art{position:relative;min-height:470px;display:grid;place-items:center}.art-circle{width:min(390px,76vw);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 28%,#fff 0 10%,transparent 11%),linear-gradient(145deg,#e3aaba,#c45678);box-shadow:18px 22px 0 #f3d7dc;transform:rotate(-8deg)}.art-circle:after{content:'✦';position:absolute;font-size:8rem;color:rgba(255,255,255,.25);transform:translate(180px,80px)}.art-word{position:absolute;font-size:5rem;line-height:.72;color:#fff;font-weight:800;letter-spacing:-.08em;text-align:center;transform:rotate(-8deg);text-shadow:4px 6px 0 rgba(95,38,56,.12)}.art-word strong{font-weight:400;font-size:.78em}.art-card{position:absolute;display:flex;align-items:center;gap:8px;background:#fff;border-radius:12px;padding:12px 16px;box-shadow:var(--shadow-md);font-size:.72rem}.art-card i{color:var(--color-primary);font-size:1.1rem}.art-card-top{top:93px;right:10px;transform:rotate(6deg)}.art-card-bottom{bottom:86px;left:5px;transform:rotate(-6deg)}.home-benefits{position:relative;z-index:2;margin-top:-32px;background:#fff;border-radius:18px;box-shadow:var(--shadow-md);padding:20px 26px;display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.home-benefits>div{display:flex;align-items:center;gap:11px;border-left:1px solid var(--color-line);padding-left:16px}.home-benefits>div:last-child{border-left:0}.home-benefits i{color:var(--color-primary);font-size:1.3rem}.home-benefits span{display:flex;flex-direction:column;font-size:.75rem}.home-benefits small{color:var(--color-muted);font-size:.68rem}.editorial-banner{margin-top:70px;background:#f8f1ed;overflow:hidden}.editorial-inner{min-height:310px;display:flex;align-items:center;justify-content:space-between;gap:30px}.editorial-inner h2{font-size:clamp(2rem,4vw,3.5rem);line-height:1.2;margin:10px 0}.editorial-inner p{color:#70666b;max-width:440px}.editorial-stamp{width:220px;height:220px;border-radius:50%;border:1px solid #d1b9b1;display:grid;place-items:center;position:relative;color:var(--color-primary);transform:rotate(12deg);font-size:1.6rem;line-height:1.05;text-align:center;letter-spacing:.12em}.editorial-stamp i{position:absolute;font-size:2.5rem;color:#d2a770;transform:translate(88px,-86px)}@media(max-width:700px){.home-intro-inner{grid-template-columns:1fr;min-height:0}.home-intro-copy{padding:55px 0 10px}.home-intro-art{min-height:310px}.art-circle{width:260px}.art-word{font-size:3.2rem}.art-card-top{top:28px}.art-card-bottom{bottom:30px}.home-benefits{grid-template-columns:repeat(2,1fr);gap:14px;padding:17px}.home-benefits>div{border-left:0;padding-left:0}.editorial-inner{padding-block:45px;align-items:start}.editorial-stamp{width:150px;height:150px;font-size:1rem;flex:none}.editorial-stamp i{transform:translate(55px,-60px)}}
</style>{% endblock %}
