{% extends 'layouts/master.twig' %}
{% block title %}{{ loyalty.name }} — {{ store.name }}{% endblock %}
{% block content %}<div class="page-shell"><div class="container"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><section class="loyalty-hero"><div><span class="eyebrow eyebrow-light">تكافئين على كل خطوة</span><h1>{{ loyalty.name }}</h1><p>{{ loyalty.description }}</p>{% if user.loyalty_points %}<strong class="loyalty-points">{{ user.loyalty_points }} نقطة</strong>{% endif %}</div><i class="sicon-star2"></i></section>{% if loyalty.points|length %}<section class="loyalty-section"><div class="section-heading"><div><h2>كيف تجمعين النقاط؟</h2></div></div><div class="loyalty-grid">{% for point in loyalty.points %}<div class="loyalty-card"><i class="{{ point.icon|default('sicon-star') }}" style="color:{{ point.color|default('var(--color-primary)') }}"></i><strong>{{ point.points }} نقطة</strong><p>{{ point.description }}</p>{% if point.url %}<a class="text-link" href="{{ point.url }}">{{ point.name }}</a>{% endif %}</div>{% endfor %}</div></section>{% endif %}{% for group in loyalty.prizes %}<section class="loyalty-section"><div class="section-heading"><div><h2>{{ group.title }}</h2></div></div><div class="prize-grid">{% for prize in group.items %}<article class="prize-card">{% if prize.image %}<img src="{{ prize.image }}" alt="{{ prize.name }}">{% endif %}<div><h3>{{ prize.name }}</h3><p>{{ prize.description }}</p><strong>{{ prize.cost_points }} نقطة</strong></div></article>{% endfor %}</div></section>{% endfor %}</div></div>{% endblock %}{% block scripts %}<style>.loyalty-hero{display:flex;justify-content:space-between;align-items:center;min-height:290px;border-radius:24px;padding:42px;background:linear-gradient(120deg,#593845,#c45678);color:#fff;overflow:hidden}.loyalty-hero h1{font-size:clamp(2rem,5vw,3.5rem);margin:12px 0}.loyalty-hero p{color:#f1dfe4;max-width:550px}.loyalty-hero>i{font-size:10rem;color:rgba(255,255,255,.16);transform:rotate(15deg)}.loyalty-points{display:inline-block;margin-top:15px;background:#fff;color:var(--color-primary);padding:8px 18px;border-radius:999px}.loyalty-section{margin-top:52px}.loyalty-grid,.prize-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.loyalty-card,.prize-card{border:1px solid var(--color-line);border-radius:16px;padding:20px;background:#fff}.loyalty-card>i{font-size:1.8rem;display:block;margin-bottom:12px}.loyalty-card strong,.prize-card strong{color:var(--color-primary)}.loyalty-card p,.prize-card p{font-size:.8rem;color:var(--color-muted)}.prize-card{display:flex;gap:14px}.prize-card img{width:90px;height:90px;border-radius:10px;object-fit:cover;background:#f8f3f1}.prize-card h3{font-size:.9rem;margin:0 0 4px}@media(max-width:650px){.loyalty-hero>i{font-size:6rem}.loyalty-grid,.prize-grid{grid-template-columns:1fr 1fr}}@media(max-width:450px){.loyalty-grid,.prize-grid{grid-template-columns:1fr}.loyalty-hero{padding:28px}}
</style>{% endblock %}
