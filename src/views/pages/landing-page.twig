{% block content %}<main class="landing-page"><section class="landing-hero"><div class="container"><span class="eyebrow eyebrow-light">لفترة محدودة</span><h1>طقس عناية<br><em>يبدأ بك.</em></h1><p>اكتشفي تشكيلتنا المختارة لبداية أجمل مع عرض خاص لفترة محدودة.</p><a class="btn btn-primary" href="{{ link('/offers') }}">اكتشفي العرض <i class="sicon-keyboard_arrow_left"></i></a></div></section><section class="container landing-content"><div class="section-heading"><div><span class="eyebrow">مختاراتنا</span><h2>الأكثر حبًا هذا الأسبوع</h2></div></div><salla-products-list source="offers" class="product-grid"></salla-products-list></section></main>{% endblock %}{% block scripts %}<style>.landing-hero{padding:110px 0;background:radial-gradient(circle at 75% 30%,#e8b5c3,transparent 24%),linear-gradient(120deg,#4d303d,#bd617f);color:#fff}.landing-hero h1{font-size:clamp(3rem,8vw,6.5rem);line-height:1.03;margin:18px 0}.landing-hero h1 em{font-style:normal;color:#f6d2a1}.landing-hero p{max-width:450px;color:#f2e2e7;margin-bottom:26px}.landing-content{padding-block:65px}
