{% extends 'layouts/master.twig' %}
{% block title %}المجلة — {{ store.name }}{% endblock %}
{% block content %}<div class="page-shell"><div class="container"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><div class="section-heading"><div><span class="eyebrow">نقرأ، نجرب، ونشارك</span><h1>مجلة BellaBox</h1><p>أفكار بسيطة تساعدك على فهم احتياجات بشرتك واختيار ما يناسبك.</p></div></div>{% if categories|length %}<nav class="blog-categories"><a href="{{ link('/blog') }}" class="is-active">كل المقالات</a>{% for category in categories %}<a href="{{ category.url }}">{{ category.name }}</a>{% endfor %}</nav>{% endif %}{% if slides|length %}<salla-slider type="blog" auto-play pagination class="blog-feature"><div slot="items">{% for article in slides %}<a class="blog-feature-card" href="{{ article.url }}">{% if article.has_image %}<img src="{{ article.image.url }}" alt="{{ article.image.alt }}">{% endif %}<div><span class="eyebrow eyebrow-light">اختيار المحررة</span><h2>{{ article.title }}</h2><p>{{ article.summary }}</p></div></a>{% endfor %}</div></salla-slider>{% endif %}{% if articles|length %}{% hook 'blog:index.items.start' %}<salla-infinite-scroll next-page="{{ articles.next_page }}" autoload class="article-grid">{% for article in articles %}<article class="article-card"><a class="article-image" href="{{ article.url }}">{% if article.has_image %}<img src="{{ article.image.url }}" alt="{{ article.image.alt }}" loading="lazy">{% endif %}</a><div class="article-body"><div class="article-meta">{{ article.created_at|date }}{% if article.author.name %} · {{ article.author.name }}{% endif %}</div><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.summary }}</p><a class="text-link" href="{{ article.url }}">اقرئي المزيد <i class="sicon-keyboard_arrow_left"></i></a></div></article>{% endfor %}</salla-infinite-scroll>{% hook 'blog:index.items.end' %}{% else %}<div class="empty-state"><i class="sicon-book"></i><p>{{ trans('pages.blog_categories.no_articles') }}</p></div>{% endif %}</div></div>{% endblock %}{% block scripts %}<style>.blog-categories{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}.blog-categories a{border:1px solid var(--color-line);padding:8px 16px;border-radius:999px;font-size:.8rem}.blog-categories a:hover,.blog-categories a.is-active{background:var(--color-primary);border-color:var(--color-primary);color:#fff}.blog-feature{display:block;margin-bottom:32px}.blog-feature-card{display:block;position:relative;min-height:330px;border-radius:22px;overflow:hidden;background:#3a3035;color:#fff}.blog-feature-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.56}.blog-feature-card:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(31,19,25,.88),transparent 75%)}.blog-feature-card>div{position:absolute;z-index:1;right:30px;bottom:26px;max-width:620px}.blog-feature-card h2{font-size:clamp(1.4rem,3vw,2.5rem);margin:9px 0}.blog-feature-card p{color:#e0d4d9}.article-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.article-card{border:1px solid var(--color-line);border-radius:18px;overflow:hidden;background:#fff}.article-image{display:block;aspect-ratio:1.5;background:#f8f3f1}.article-image img{width:100%;height:100%;object-fit:cover}.article-body{padding:18px}.article-meta{font-size:.72rem;color:var(--color-muted)}.article-body h2{font-size:1.05rem;line-height:1.5;margin:8px 0}.article-body p{font-size:.8rem;color:var(--color-muted);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.article-body .text-link{font-size:.78rem}@media(max-width:700px){.article-grid{grid-template-columns:1fr 1fr}}@media(max-width:480px){.article-grid{grid-template-columns:1fr}}
</style>{% endblock %}
