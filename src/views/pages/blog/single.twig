{% extends 'layouts/master.twig' %}
{% block title %}{{ article.title }} — {{ store.name }}{% endblock %}
{% block content %}<div class="page-shell"><div class="container"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><div class="article-single-layout"><article class="content-card article-single"><div class="article-meta">{{ article.created_at|date }}{% if article.author.name %} · {{ article.author.name }}{% endif %}</div><h1>{{ article.title }}</h1>{% if article.has_image %}<img class="article-cover" src="{{ article.image.url }}" alt="{{ article.image.alt|default(article.title) }}">{% endif %}<div class="prose">{{ article.body|replace({'&nbsp;':' '})|raw }}</div>{% if article.tags|length %}<div class="detail-tags">{% for tag in article.tags %}<a href="{{ tag.url }}">#{{ tag.name }}</a>{% endfor %}</div>{% endif %}{% if store.settings.blog.allow_likes_and_comments %}<div class="article-actions"><button type="button" id="blog-like" data-blog-id="{{ article.key }}"><i class="sicon-thumbs-up"></i> أعجبني <span>{{ article.likes_count }}</span></button></div><salla-comments data-testid="store-blog-comments" item-id="{{ article.key }}" type="blog"></salla-comments>{% endif %}</article><aside class="article-aside">{% if related|length %}<h2>قد يعجبك أيضًا</h2>{% for item in related %}<a class="related-article" href="{{ item.url }}">{% if item.has_image %}<img src="{{ item.image.url }}" alt="{{ item.image.alt }}">{% endif %}<span>{{ item.title }}</span></a>{% endfor %}{% endif %}</aside></div></div></div>{% endblock %}{% block scripts %}<style>.article-single-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:28px;align-items:start}.article-single h1{font-size:clamp(1.8rem,4vw,3.2rem);line-height:1.35;margin:12px 0 28px}.article-cover{width:100%;max-height:480px;object-fit:cover;border-radius:16px;margin-bottom:28px}.article-actions button{border:1px solid var(--color-line);background:#fff;border-radius:999px;padding:9px 16px;color:var(--color-primary)}.article-aside{position:sticky;top:110px}.article-aside h2{font-size:1.1rem;margin:0 0 14px}.related-article{display:flex;gap:10px;align-items:center;padding:10px;border:1px solid var(--color-line);border-radius:12px;margin-bottom:10px;font-size:.78rem;font-weight:700}.related-article img{width:65px;height:65px;object-fit:cover;border-radius:8px;background:#f8f3f1}@media(max-width:750px){.article-single-layout{grid-template-columns:1fr}.article-aside{position:static}}
</style>{% endblock %}
