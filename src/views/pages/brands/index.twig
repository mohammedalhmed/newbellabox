{% extends 'layouts/master.twig' %}
{% block title %}الماركات — {{ store.name }}{% endblock %}
{% block content %}<div class="page-shell"><div class="container"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><div class="section-heading"><div><span class="eyebrow">اختيارات موثوقة</span><h1>الماركات</h1><p>تعرّفي على العلامات التي نختارها لك بعناية.</p></div></div>{% if brands|length %}<div class="brands-grid">{% for char,group in brands %}{% for brand in group %}<a class="brand-card" href="{{ brand.url }}"><img src="{{ brand.logo }}" alt="{{ brand.name }}" loading="lazy"><span>{{ brand.name }}</span></a>{% endfor %}{% endfor %}</div>{% else %}<div class="empty-state"><i class="sicon-award-ribbon"></i><p>{{ trans('pages.brands.non_brands') }}</p></div>{% endif %}</div></div>{% endblock %}{% block scripts %}<style>.brands-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.brand-card{min-height:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;border:1px solid var(--color-line);border-radius:16px;padding:18px;transition:.2s var(--ease)}.brand-card:hover{border-color:var(--color-primary);box-shadow:var(--shadow-sm);transform:translateY(-3px)}.brand-card img{width:110px;height:55px;object-fit:contain}.brand-card span{font-size:.78rem;font-weight:700}@media(max-width:800px){.brands-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:480px){.brands-grid{grid-template-columns:repeat(2,1fr)}}
</style>{% endblock %}
