{% extends 'layouts/master.twig' %}
{% block title %}{{ brand.name }} — {{ store.name }}{% endblock %}
{% block content %}<div class="page-shell"><div class="container"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><div class="brand-hero"><div class="brand-logo-large">{% if brand.logo %}<img src="{{ brand.logo }}" alt="{{ brand.name }}">{% endif %}</div><div><span class="eyebrow">ماركة مختارة</span><h1>{{ brand.name }}</h1>{% if brand.description %}<p>{{ brand.description|raw }}</p>{% endif %}</div></div><div class="section-heading"><div><h2>منتجات {{ brand.name }}</h2></div></div><salla-products-list data-testid="store-brand-products" source="brand" source-value="{{ brand.id }}" class="product-grid"></salla-products-list></div></div>{% endblock %}{% block scripts %}<style>.brand-hero{display:flex;align-items:center;gap:32px;padding:34px;background:var(--color-soft);border-radius:22px;margin-bottom:52px}.brand-logo-large{width:150px;height:110px;background:#fff;border-radius:14px;display:grid;place-items:center}.brand-logo-large img{max-width:120px;max-height:75px}.brand-hero h1{font-size:2.3rem;margin:8px 0}.brand-hero p{color:var(--color-muted);margin:0}@media(max-width:600px){.brand-hero{align-items:start;flex-direction:column}.brand-logo-large{width:120px;height:90px}}
</style>{% endblock %}
