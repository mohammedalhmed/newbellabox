{% extends 'layouts/master.twig' %}
{% block title %}تمت العملية بنجاح — {{ store.name }}{% endblock %}
{% block content %}<div class="page-shell"><div class="container"><div class="thank-you-card content-card"><div class="thank-you-icon"><i class="sicon-check"></i></div><span class="eyebrow">شكرًا لثقتك</span><h1>تمت العملية بنجاح</h1><p>يسعدنا وجودك معنا. ستصلك التفاصيل والتحديثات على وسيلة التواصل المسجلة لديك.</p><div class="thank-you-actions"><a class="btn btn-primary" href="{{ store.url }}">العودة للرئيسية</a><a class="btn btn-outline" href="{{ link('/products') }}">متابعة التسوق</a></div></div></div></div>{% endblock %}{% block scripts %}<style>.thank-you-card{text-align:center;max-width:680px;margin:60px auto;padding:70px 30px}.thank-you-icon{width:76px;height:76px;margin:0 auto 22px;border-radius:50%;display:grid;place-items:center;background:#e6f4eb;color:#3b9b5c;font-size:2rem}.thank-you-card h1{font-size:2.5rem;margin:12px 0}.thank-you-card p{color:var(--color-muted)}.thank-you-actions{display:flex;justify-content:center;gap:10px;margin-top:28px}@media(max-width:480px){.thank-you-actions{flex-direction:column}}
</style>{% endblock %}
