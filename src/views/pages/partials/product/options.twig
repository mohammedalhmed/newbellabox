{% if product.options|length %}<div class="product-options">{% for option in product.options %}{% if option.type in ['splitter'] %}{{ option.element|raw }}{% else %}{% if option.type != 'donation' %}<div class="product-option"><label for="options[{{ option.id }}]">{{ option.name }}{% if option.required %} *{% endif %}</label>{{ option.element(product.id)|raw }}</div>{% endif %}{% endif %}{% endfor %}</div>{% endif %}{% if product.can_add_note %}<div class="product-option"><label for="product-notes">ملاحظات الطلب</label><textarea id="product-notes" name="notes" rows="3" placeholder="هل لديك ملاحظة خاصة؟">{{ product.notes }}</textarea></div>{% endif %}{% if product.has_metadata %}<salla-metadata></salla-metadata>{% endif %}
