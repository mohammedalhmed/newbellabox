{% extends 'layouts/master.twig' %}
{% block title %}سلة التسوق — {{ store.name }}{% endblock %}
{% block content %}<div class="page-shell"><div class="container"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><div class="section-heading"><div><span class="eyebrow">خطوتك الأخيرة قبل الاستمتاع</span><h1>سلة التسوق</h1></div></div><salla-conditional-offer data-testid="store-cart-conditional-offer"></salla-conditional-offer><div class="cart-layout"><div class="cart-items">{% hook 'cart:items.start' %}{% for item in cart.items %}<form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}"><article class="cart-item"><input type="hidden" name="id" value="{{ item.id }}"><a href="{{ item.url }}" class="cart-item-image"><img src="{{ item.product_image }}" alt="{{ item.product_name }}"></a><div class="cart-item-info"><h2><a href="{{ item.url }}">{{ item.product_name }}</a></h2>{% if item.offer %}<span class="cart-offer">{{ item.offer.names }}</span>{% endif %}<div class="cart-item-price">{{ item.price|money }}</div>{% include 'pages/partials/product/options.twig' with {product:item} %}</div><div class="cart-item-controls">{% if item.is_hidden_quantity %}<input type="hidden" name="quantity" value="{{ item.quantity }}"><span>{{ item.quantity }}</span>{% else %}<salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}" value="{{ item.quantity }}" name="quantity"></salla-quantity-input>{% endif %}<strong>{{ item.total|money }}</strong></div><salla-button type="button" shape="icon" color="danger" aria-label="حذف {{ item.product_name }}" onclick="salla.cart.deleteItem('{{ item.id }}').then(function(){document.querySelector('#item-{{ item.id }}').remove()})"><i class="sicon-cancel"></i></salla-button></article></form>{% else %}<div class="empty-state"><i class="sicon-shopping-bag"></i><h2>سلتك فارغة حاليًا</h2><p>أضيفي المنتجات التي تحبينها وستظهر هنا.</p><a class="btn btn-primary" href="{{ link('/products') }}">ابدئي التسوق</a></div>{% endfor %}{% hook 'cart:items.end' %}</div>{% if cart.items|length %}<aside class="cart-summary"><div class="free-shipping-card"><i class="sicon-shipping-fast"></i><div><b>{% if cart.free_shipping_bar.has_free_shipping %}مبروك! حصلتِ على الشحن المجاني{% else %}تبقى {{ cart.free_shipping_bar.remaining|money }} للشحن المجاني{% endif %}</b><div class="shipping-progress"><span style="width:{{ cart.free_shipping_bar.percent|default(0) }}%"></span></div></div></div>{% if store.settings.cart.apply_coupon_enabled %}<div class="coupon-card"><label for="coupon">لديك كوبون؟</label><salla-cart-coupons data-testid="store-cart-coupons"></salla-cart-coupons></div>{% endif %}<salla-cart-summary-card data-testid="store-cart-summary"></salla-cart-summary-card><salla-button onclick="salla.cart.submit()" loader-position="end" width="wide" class="btn btn-primary checkout-button">إتمام الطلب <i class="sicon-keyboard_arrow_left"></i></salla-button>{% hook 'cart:summary.end' %}</aside>{% endif %}</div></div></div>{% endblock %}{% block scripts %}<script defer src="{{ 'checkout.js'|asset }}"></script><style>.cart-layout{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:28px;align-items:start}.cart-items{min-width:0}.cart-item{position:relative;display:grid;grid-template-columns:100px 1fr auto 34px;gap:18px;align-items:start;background:#fff;border:1px solid var(--color-line);border-radius:18px;padding:18px;margin-bottom:12px}.cart-item-image{width:100px;height:100px;border-radius:12px;overflow:hidden;background:#f8f3f1}.cart-item-image img{width:100%;height:100%;object-fit:cover}.cart-item-info h2{font-size:1rem;margin:2px 0 5px}.cart-item-price{font-weight:800;color:var(--color-primary)}.cart-offer{font-size:.75rem;color:#a87834}.cart-item-controls{display:flex;flex-direction:column;align-items:end;gap:16px}.cart-summary{position:sticky;top:110px}.free-shipping-card,.coupon-card{display:flex;gap:12px;align-items:flex-start;background:#fbf2e5;border-radius:16px;padding:17px;margin-bottom:12px;color:#795527}.free-shipping-card>i{font-size:1.4rem}.shipping-progress{height:6px;background:#eadbc6;border-radius:99px;margin-top:12px;overflow:hidden}.shipping-progress span{display:block;height:100%;background:#c69858;border-radius:inherit}.coupon-card{display:block;background:#fff;border:1px solid var(--color-line);color:var(--color-ink)}.coupon-card label{display:block;font-weight:700;margin-bottom:10px}.checkout-button{width:100%;margin-top:12px}.cart-item> salla-button{align-self:start}@media(max-width:850px){.cart-layout{grid-template-columns:1fr}.cart-summary{position:static}}@media(max-width:600px){.cart-item{grid-template-columns:74px 1fr 30px;gap:12px;padding:12px}.cart-item-image{width:74px;height:74px}.cart-item-controls{grid-column:2/-1;flex-direction:row;align-items:center;justify-content:space-between}.cart-item h2{font-size:.85rem}.cart-item> salla-button{grid-column:3;grid-row:1}}
</style>{% endblock %}
