{% extends 'layouts/master.twig' %}
{% block title %}{{ page.title|striptags }} — {{ store.name }}{% endblock %}
{% block content %}<div class="page-shell"><div class="container">{% if theme.settings.get('product_index_show_breadcrumbs', true) %}<nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav>{% endif %}<div class="products-toolbar"><div><span class="eyebrow">اختاري ما يناسبك</span><h1>{{ page.title|raw }}</h1></div><div class="sort-control">{% if filters %}<a class="btn btn-soft" href="#filters-menu"><i class="sicon-filter"></i> تصفية</a>{% endif %}{% if sort_options|length %}<label for="product-sort">ترتيب حسب</label><select id="product-sort">{% for sort in sort_options %}<option value="{{ sort.id }}" {{ sort.is_selected?'selected':'' }}>{{ sort.name }}</option>{% endfor %}</select>{% endif %}</div></div><div class="listing-layout">{% if filters %}<aside class="listing-filters" id="filters-menu"><salla-filters data-testid="store-products-filters"></salla-filters></aside>{% endif %}<div class="listing-main">{% hook 'product:index.items.start' %}<salla-products-list data-testid="store-products-list" class="product-grid" source="{{ page.slug }}" source-value="{{ page.id }}" {{ filters ? 'filters-Results' : '' }}></salla-products-list>{% hook 'product:index.items.end' %}</div></div></div></div>{% endblock %}
{% block scripts %}<script defer src="{{ 'product.js'|asset }}"></script><style>.listing-layout{display:flex;align-items:flex-start;gap:28px}.listing-filters{width:250px;flex:none;position:sticky;top:105px;background:#fff;border:1px solid var(--color-line);border-radius:16px;padding:16px}.listing-main{flex:1;min-width:0}@media(max-width:800px){.listing-layout{display:block}.listing-filters{width:100%;position:static;margin-bottom:18px}.sort-control{width:100%;justify-content:space-between}.sort-control select{max-width:160px}}</style>{% endblock %}
